# 复制为服务器的 ~/projects/pillxa-dispenser/v1/shared/server.env，不把真实密钥提交进 Git。
# 只使用简单的 KEY=value 写法；部署工具将这些值传给 Docker Compose。
V1_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# 已有反向代理时使用 127.0.0.1；直接通过服务器 5068 端口访问时可设 0.0.0.0。
# 这是学校宿主机发布端口的地址；容器内部固定监听 0.0.0.0:5068。
V1_BIND_ADDRESS=127.0.0.1
V1_PORT=5068
V1_THREADS=4
# 对外网址的路径前缀；学校代理将 /dispenser/ 剥除后转发给容器。根路径部署时留空。
V1_URL_PREFIX=/dispenser
