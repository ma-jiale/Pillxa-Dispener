{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pillxai Dispenser",
  "version": "0.2.1",
  "identifier": "com.pillxa.dispenser",
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } },
  "build": { "frontendDist": "../../../dist/web", "devUrl": "http://127.0.0.1:1420" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http: https:; media-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "category": "Medical",
    "shortDescription": "养老院处方管理与摆药工作空间",
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "resources": { "resources/": "resources/" },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
