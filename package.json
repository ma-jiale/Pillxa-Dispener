{
  "name": "pillxa-dispenser",
  "private": true,
  "type": "module",
  "version": "0.2.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:policy": "node --test tests/policy/*.test.ts",
    "dev:api": "node --experimental-strip-types apps/api/src/main.ts",
    "dev:web": "node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "dev:desktop": "node tooling/dev-desktop.mjs",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "build:web": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "test": "node --test tests/policy/*.test.ts tests/api/*.test.ts tests/ui/*.test.ts",
    "dev:bridge": "node tooling/local-bridge.ts",
    "contracts:generate": "node tooling/generate-contracts.mjs",
    "icons:export": "node tooling/export-app-icons.mjs",
    "build:windows": "pwsh -NoProfile -File tooling/build-windows.ps1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@zxing/browser": "^0.2.1",
    "bwip-js": "^4.11.4",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "lucide-react": "^1.51.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@types/bwip-js": "^4.0.0",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0",
    "@typespec/json-schema": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "8.1.0"
  }
